# ==============================================================================
# PF Sahi Karo — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit real production credentials to version control.

# --- Public Client Variables (Exposed to Browser) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Feature Flag: Demo Mode (true/false)
# WARNING: Demo mode is automatically disabled in production (NODE_ENV=production).
NEXT_PUBLIC_DEMO_MODE=false

# --- Private Server Variables (Never Exposed to Browser) ---
# Supabase Service Role Key — Required only for secure administrative migrations & webhooks
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: External Integration Rate Limiting & Health Checks
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
